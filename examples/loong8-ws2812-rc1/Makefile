# loong8-ws2812-rc1 — WS2812B LED 控制器
# 完整 RTL→GDSII 流程演示（零 Python 依赖）
#
# 快速开始:  ./build.sh          # 一键全流程
#            ./build.sh gds      # 仅 GDS
#            ./build.sh clean    # 清理

all:
	./build.sh

synth:
	./build.sh synth

pnr:
	./build.sh pnr

gds:
	./build.sh gds

clean:
	./build.sh clean

.PHONY: all synth pnr gds clean

--- a/src/sta/CMakeLists.txt
+++ b/src/sta/CMakeLists.txt
@@ -61,12 +61,16 @@
 # Enable Link-Time Optimization (LTO) for Release builds.
-include(CheckIPOSupported)
-check_ipo_supported(RESULT ipo_supported OUTPUT ipo_error)
-if(ipo_supported)
-  set(CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE TRUE)
-  message(STATUS "IPO/LTO: enabled for Release builds")
-else()
-  message(STATUS "IPO/LTO: not supported - ${ipo_error}")
-endif()
+# Disabled on LoongArch due to GCC LTO bugs.
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "loongarch|loongson")
+  message(STATUS "IPO/LTO: disabled for LoongArch")
+  set(CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE FALSE)
+else()
+  include(CheckIPOSupported)
+  check_ipo_supported(RESULT ipo_supported OUTPUT ipo_error)
+  if(ipo_supported)
+    set(CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE TRUE)
+    message(STATUS "IPO/LTO: enabled for Release builds")
+  else()
+    message(STATUS "IPO/LTO: not supported - ${ipo_error}")
+  endif()
+endif()

@@ -564,6 +568,9 @@
   ${CUDD_LIB}
   )

+# ABC's CUDD headers need the abc_namespaces.h header for proper
+# extern "C" linkage (ABC_NAMESPACE_HEADER_START/END macros).
+
 if(NOT HAVE_CXX_STD_FORMAT)
   if(STA_USE_SPDLOG_FMT)
     target_include_directories(OpenSTA PUBLIC "${_fmt_dir}")


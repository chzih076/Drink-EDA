#!/bin/sh
# gen_pdk_libs - PDK Liberty 维护工具（纯 sh）
# 用法: gen_pdk_libs [copy|expand|both]
set -e
PDK_ROOT="${PDK_ROOT:-/home/lik/.local/share/pdk}"
SRC_DIR="${SRC_DIR:-/run/media/lik/git/skywater-pdk/libraries/sky130_fd_sc_hd/latest}"
LIB_DIR="$PDK_ROOT/sky130A/libs.ref/sky130_fd_sc_hd/lib"

cmd="${1:-all}"

copy_original() {
    echo "=== 恢复原始 LIB ==="
    for ver in sky130A sky130B; do
        dst="$PDK_ROOT/$ver/libs.ref/sky130_fd_sc_hd/lib"
        ls "$SRC_DIR/timing/"*.lib 2>/dev/null | while read f; do
            name=$(basename "$f" | sed 's/sky130_fd_sc_hd__//')
            cp "$f" "$dst/$name" 2>/dev/null || true
        done
        echo "  $ver: 原始 LIB 已恢复"
    done
}

expand_libs() {
    echo "=== 展开 PnR LIB（需要 Python） ==="
    echo "  使用 python3 gen_pdk_libs.py expand 获得完整功能"
    echo "  或查看 patches/gen_pdk_libs.py"
}

case "$cmd" in
    copy) copy_original ;;
    expand) expand_libs ;;
    both) copy_original; expand_libs ;;
    *) echo "用法: gen_pdk_libs [copy|expand|both]" ;;
esac
echo "Done"

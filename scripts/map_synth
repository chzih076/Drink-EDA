def map_netlist(infile, outfile):
    with open(infile) as f:
        content = f.read()
    
    # 只替换 cell 实例（缩进的行 + cell名 + 空格 + 实例名 + (）
    def replace_cell(m):
        indent = m.group(1)
        short = m.group(2)
        inst = m.group(3)
        mapped = MAP.get(short, short)
        return f"{indent}{mapped} {inst}("
    
    new_content = re.sub(r'^(\s+)(\w+)\s+(\w+)\s*\(', replace_cell, content, flags=re.MULTILINE)
    
    # 也替换 .submod 和 module 名？
    # module 名不用改（只是定义）
    
    with open(outfile, 'w') as f:
        f.write(new_content)
    
    # 统计
    old_cells = len(re.findall(r'\b(\w+)\(', content))
    mapped_count = sum(1 for short, long in MAP.items() 
                       if re.search(rf'\b{short}\(', content))
    print(f"  {os.path.basename(infile)}: {mapped_count} cells renamed → {os.path.basename(outfile)}")

if __name__ == '__main__':
    if len(sys.argv) < 3:
        print("用法: map_synth <输入.v> <输出.v>")
        sys.exit(1)
    map_netlist(sys.argv[1], sys.argv[2])

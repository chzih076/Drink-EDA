#!/usr/bin/env bash
# lfl - LibreLane Flow with PnR cell mapping for LoongArch
set -e
CONFIG="$(readlink -f "$1")"
shift
CONFIG_DIR="$(dirname "$CONFIG")"
PDK_ROOT="${PDK_ROOT:-/home/lik/.local/share/pdk}"
export PDK_ROOT
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:/home/lik/.local/lib/python3.14/site-packages/klayout"

cd "$CONFIG_DIR"

echo "=== Phase 1: Synthesis (158 cell LIB) ==="
librelane --manual-pdk --pdk-root "$PDK_ROOT" \
  --skip Verilator.Lint \
  --to OpenROAD.STAPrePNR \
  "$CONFIG" "$@" 2>&1 || true

# 找到合成的网表
NL=$(find runs -name "spm.nl.v" -path "*/yosys-synthesis/*" 2>/dev/null | head -1)
if [ -z "$NL" ]; then
  echo "❌ 找不到合成网表"
  exit 1
fi

echo "=== Phase 2: Rename cells for PnR LIB ==="
MAPPED="${NL%.v}_pnr.v"
map_synth "$NL" "$MAPPED"

# 替换网表路径
python3 -c "
import re
with open('$CONFIG') as f:
    c = f.read()
c = re.sub(r'(tt_025C_1v80)\.lib', r'\1_pnr.lib', c)
c = re.sub(r'VERILOG_FILES.*', 'VERILOG_FILES: \"$MAPPED\"', c)
with open('${CONFIG_DIR}/.lfl_sta.yaml', 'w') as f:
    f.write(c)
"

echo "=== Phase 3: STA + PnR (465 cell LIB) ==="
librelane --manual-pdk --pdk-root "$PDK_ROOT" \
  --skip Verilator.Lint \
  --from OpenROAD.STAPrePNR \
  "${CONFIG_DIR}/.lfl_sta.yaml" "$@" 2>&1 || true

rm -f "${CONFIG_DIR}/.lfl_sta.yaml"
echo "=== Done ==="
